# ─── BigQuery (Meta/Facebook Ads data) ───────────────────────────────────────
# Auth: gcloud auth application-default login
#   OR: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BIGQUERY_PROJECT_ID=your_gcp_project_id
BIGQUERY_DATASET=your_dataset_name
BIGQUERY_TABLE=your_table_name

# ─── TikTok Ads API ───────────────────────────────────────────────────────────
# Get from: https://ads.tiktok.com/marketing_api/homepage
TIKTOK_ACCESS_TOKEN=your_access_token_here
TIKTOK_ADVERTISER_ID=your_advertiser_id_here

# ─── Google Ads API (optional — MY only) ─────────────────────────────────────
# Get from: https://developers.google.com/google-ads/api/docs/get-started/introduction
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id_no_dashes

# ─── Pipeline settings ────────────────────────────────────────────────────────
CYCLE_DURATION_DAYS=14
